# ── Discord Bot Token ──────────────────────────────────
# Get this from https://discord.com/developers/applications
# Create an app → Bot → Reset Token → Copy
# This is long (usually 59+ characters). Do not use the client secret.
DISCORD_TOKEN=your_bot_token_here
# Optional: force process exit when Discord stays down (default keeps process up)
# DISCORD_EXIT_ON_DOWN=1
# Optional overrides for Discord readiness and reconnect windows (milliseconds)
# DISCORD_READY_GRACE_MS=600000
# DISCORD_RECONNECT_MS=300000

# ── Client ID ───────────────────────────────────────────
# Found on the same developer page under "General Information" → "App ID"
CLIENT_ID=your_app_id_here

# ── Guild ID (optional, for fast slash command registration) ─
# Right-click your Discord server icon → Copy Server ID (Developer Mode on)
GUILD_ID=

# ── Wise Old Man Group ID ───────────────────────────────
# From https://wiseoldman.net/groups — the number in the group URL
WOM_GROUP_ID=

# ── Wise Old Man Verification Code ──────────────────────
# From your WOM group page → Settings. Needed for SOTW auto-creation.
# Never commit this value.
WOM_VERIFICATION_CODE=

# ── Wise Old Man API Key (optional) ────────────────────
# Increases rate limit from 20 to 100 req/min. Register at
# https://wiseoldman.net → Account → API Keys
WOM_API_KEY=

# ── Default Reminder Channel ────────────────────────────
# Channel ID where event reminders are posted by default.
# Right-click the channel → Copy ID
DEFAULT_REMINDER_CHANNEL=

# ── Database ────────────────────────────────────────────
# On Render, prefer the Postgres plugin. Paste the INTERNAL URL here
# (Render dashboard → the database → Connections). Never commit this.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB
DATABASE_URL=
# SQLite fallback (local only). On Render without DATABASE_URL you need a disk:
# DB_PATH=/data/data.db
DB_PATH=

# Incoming webhooks for Twitch / RuneLite / news. Leave blank to keep the HTTP server off.
# WEBHOOK_PORT=8787
WEBHOOK_PORT=

# ── OpenAI (optional) ───────────────────────────────────
# Writes Venny-voice title + blurb on events, reminders, raffles,
# SOTW, bingo, votes, and leaderboard cards. Facts stay in code.
# Never commit the real key. Also set this on Render.
OPENAI_API_KEY=

# ── HTTP API (optional) ─────────────────────────────────
# Lets Grok / dashboards POST to the same Render URL as /health.
# Header: Authorization: Bearer <token>  or  x-venny-key: <token>
# Make up a password. Put the SAME value on Base44 as VITE_BOT_API_TOKEN.
# Do NOT use DISCORD_TOKEN here — rank sync will refuse it.
# Never commit the real token. Also set this on Render.
API_TOKEN=
# Extra CORS origins (comma-separated). Defaults include https://misclickerz.ai.studio
# and the old Base44 hub.
CORS_ORIGINS=
# Optional Discord role names (defaults: Woodling … Ascendant)
# ROLE_WOODLING=Woodling
# ROLE_PROSPECTOR=Prospector
# ROLE_ALCHEMIST=Alchemist
# ROLE_RANGER=Ranger
# ROLE_SLAYER=Slayer
# ROLE_GUARDIAN=Guardian
# ROLE_DRAGONBANE=Dragonbane
# ROLE_WARMASTER=Warmaster
# ROLE_DEMIGOD=Demigod
# ROLE_ASCENDANT=Ascendant

# ── Clan hub ingest (outbound) ──────────────────────────
# POST https://misclickerz.ai.studio/api/bot/webhook  (and /misclick)
# Header: X-Venny-Secret: <same secret the hub dashboard shows>
# This is NOT DISCORD_TOKEN and NOT API_TOKEN (those are for Discord / rank sync).
# Never commit the real secret. Set BOT_SECRET on Render.
# AIS_BOT_URL=https://misclickerz.ai.studio
AIS_BOT_URL=
BOT_SECRET=
