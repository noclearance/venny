# ── Discord Bot Token ──────────────────────────────────
# Get this from https://discord.com/developers/applications
# Create an app → Bot → Reset Token → Copy
# This is long (usually 59+ characters). Do not use the client secret.
DISCORD_TOKEN=your_bot_token_here

# ── Client ID ───────────────────────────────────────────
# Found on the same developer page under "General Information" → "App ID"
CLIENT_ID=your_app_id_here

# ── Guild ID (optional, for fast slash command registration) ─
# Right-click your Discord server icon → Copy Server ID (Developer Mode on)
GUILD_ID=

# ── Wise Old Man Group ID ───────────────────────────────
# From https://wiseoldman.net/groups — the number in the group URL
WOM_GROUP_ID=

# ── Wise Old Man Verification Code ──────────────────────
# From your WOM group page → Settings. Needed for SOTW auto-creation.
# Never commit this value.
WOM_VERIFICATION_CODE=

# ── Wise Old Man API Key (optional) ────────────────────
# Increases rate limit from 20 to 100 req/min. Register at
# https://wiseoldman.net → Account → API Keys
WOM_API_KEY=

# ── Default Reminder Channel ────────────────────────────
# Channel ID where event reminders are posted by default.
# Right-click the channel → Copy ID
DEFAULT_REMINDER_CHANNEL=

# ── Database path (optional) ────────────────────────────
# SQLite + OneDrive/Dropbox sync can corrupt the DB.
# If this project lives in OneDrive, point this at a local folder:
# DB_PATH=C:\Users\YourName\AppData\Local\osrs-clan-bot\data.db
DB_PATH=

# Incoming webhooks for Twitch / RuneLite / news. Leave blank to keep the HTTP server off.
# WEBHOOK_PORT=8787
WEBHOOK_PORT=
