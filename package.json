  "description": "Discord bot for OSRS clan management — events, reminders, leaderboards, raffles, and SOTW via Wise Old Man API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
